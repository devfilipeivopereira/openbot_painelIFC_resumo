#!/bin/bash
# contato — diretório de contatos do Filipe (roda no host via vps-root). PRIVADO.
# Uso: contato busca NOME|APELIDO|NUMERO | quem NUMERO_OU_JID | grupo NOME | papel TEXTO | stats
b64=$(printf '%s\0' "$@" | base64 -w0)
exec /data/.config/OpenBot/bin/vps-root "printf '%s' '$b64' | base64 -d | xargs -0 /usr/local/bin/contato"
