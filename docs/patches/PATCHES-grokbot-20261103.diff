-        if not CODEX_LIMIT_PATTERN.search(output):
-            return result
-        switch = run(["docker", "exec", "-u", "1000", "openbot", "/bin/bash", "-c",
-                      "export PATH=/data/.local/bin:$PATH; n=$(codex-auth list --skip-api --json | jq -r "
-                      "'.accounts as $a | ([$a[].active]|index(true)) as $i | $a[(($i+1) % ($a|length))].number'); "
