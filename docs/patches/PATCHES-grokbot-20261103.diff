+def fit_whatsapp_limit(whatsapp_message: str, limit: int = 3500) -> str:
+    """Trim optional highlight bullets (bottom-up) so mandatory blocks fit the WhatsApp budget.
+
+    Direct-message, Todoist and priority blocks are never trimmed; validators run afterwards."""
+    if len(whatsapp_message) <= limit:
+        return whatsapp_message
+    lines = whatsapp_message.splitlines()
+    protected, block = set(), ""
+    for index, line in enumerate(lines):
+        stripped = line.strip()
+        if stripped.startswith("*") and stripped.endswith("*") and len(stripped) > 2:
+            block = unicodedata.normalize("NFKD", stripped).encode("ascii", "ignore").decode().casefold()
+            protected.add(index)
+            continue
+        if any(key in block for key in ("mensagens diretas", "todoist", "pendencias", "prioritar")):
+            protected.add(index)
+    removable = [i for i in range(len(lines) - 1, -1, -1) if i not in protected and lines[i].strip()]
+    dropped = set()
+    for index in removable:
+        if len("\n".join(l for i, l in enumerate(lines) if i not in dropped)) <= limit:
+            break
+        dropped.add(index)
+    result = "\n".join(l for i, l in enumerate(lines) if i not in dropped)
+    result = re.sub(r"\n{3,}", "\n\n", result).strip()
+    return result
 
