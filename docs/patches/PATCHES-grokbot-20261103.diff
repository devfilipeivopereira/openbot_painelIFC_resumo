+def normalize_direct_digest(conversations: list, direct_records: list, whatsapp_message: str) -> str:
+    """Format grounded person summaries consistently and state true source absences."""
+    if not isinstance(conversations, list) or not isinstance(whatsapp_message, str):
+        raise PipelineError("whatsapp_direct_person_coverage_incomplete")
+    records_by_person = {}
+    for record in direct_records:
+        if isinstance(record, dict) and isinstance(record.get("person"), str) and record["person"].strip():
+            records_by_person.setdefault(record["person"], []).append(record)
+    ignored = {name for name in records_by_person if "filipe ivo pereira" in name.casefold()}
+    expected = set(records_by_person) - ignored
+    rows_by_person = {}
+    for row in conversations:
+        if not isinstance(row, dict) or not isinstance(row.get("person"), str):
+            raise PipelineError("whatsapp_direct_person_coverage_incomplete")
+        rows_by_person.setdefault(row["person"], []).append(row)
+    if (set(rows_by_person) - ignored) != expected or any(len(rows) != 1 for rows in rows_by_person.values()):
+        raise PipelineError("whatsapp_direct_person_coverage_incomplete")
+
+    bullets = []
+    normalized_names = []
+    def compact(value: str, limit: int) -> str:
+        value = " ".join(value.split())
+        normalized = unicodedata.normalize("NFKD", value).encode("ascii", "ignore").decode().casefold()
+        if re.search(r"\b(?:sem resposta|nenhuma resposta|nao houve resposta|nao ha resposta|nao respondeu|sem retorno|nenhum retorno|nao houve retorno)\b", normalized):
+            return "sem resposta"
+        if re.search(r"\b(?:nenhum pedido|sem pedido|nao houve pedido|nao ha pedido|nenhuma mensagem recebida|nenhuma solicitacao|nao houve solicitacao|nao ha solicitacao)\b", normalized):
+            return "nenhuma mensagem recebida" if "recebida" in normalized else "sem pedido"
+        value = value.rstrip(" .;")
+        if len(value) <= limit:
+            return value
+        cut = value[:limit].rsplit(" ", 1)[0].rstrip(" ,;:.")
+        clause = max(cut.rfind(", "), cut.rfind("; "), cut.rfind(" e "), cut.rfind(" mas "), cut.rfind(". "))
+        if clause >= max(25, len(cut) // 3):
+            cut = cut[:clause].rstrip(" ,;:.")
+        dangling = {"a","à","o","os","as","ao","de","da","do","das","dos","para","pra","em","no","na","com","e","que","um","uma","por","se","iria","ia","vai","seria","sobre","como","mas"}
+        while cut and cut.rsplit(" ", 1)[-1].casefold() in dangling and " " in cut:
+            cut = cut.rsplit(" ", 1)[0].rstrip(" ,;:.")
+        if cut and digest_terms(cut) and (digest_terms(cut) & digest_terms(value)):
+            return cut.rstrip(" ,;:.!?-") + "."
+        words = value.split()
+        selected = []
+        for word in words:
+            if not digest_terms(word):
+                continue
+            if len(" ".join(selected + [word])) > limit:
+                break
+            selected.append(word)
+            if len(selected) >= 3:
+                break
+        if not selected:
+            selected = words[:1]
+        return " ".join(selected) or value[:limit]
+    people_count = max(1, len(expected))
+    field_limit = 70 if people_count <= 3 else 55 if people_count <= 6 else 40
+    for person in sorted(expected, key=str.casefold):
+        row = rows_by_person[person][0]
+        person_records = records_by_person[person]
+        inbound = [record for record in person_records if record.get("from_me") is not True]
+        outbound = [record for record in person_records if record.get("from_me") is True]
+        if not inbound:
+            row["request"] = "Nenhum pedido ou mensagem recebida registrada nesta janela."
+        elif re.search(r"nenhuma mensagem recebida|sem pedido|nenhum pedido|nao houve pedido", unicodedata.normalize("NFKD", str(row.get("request", ""))).encode("ascii", "ignore").decode().casefold()):
+            row["request"] = "Mensagem recebida: " + str(inbound[0].get("text", "mensagem registrada"))[:240]
+        if not outbound:
+            row["response"] = "Nenhuma resposta enviada por Filipe registrada nesta janela."
+        request = compact(str(row.get("request") or "Mensagem recebida"), field_limit)
+        response = compact(str(row.get("response") or "Sem resposta registrada"), field_limit)
+        if not inbound: request = "não houve mensagem recebida"
+        if not outbound: response = "você não respondeu"
+        sentence = f"• {person} {request}; {response}."
+        sentence = sentence.replace("…", ".")
+        bullets.append(sentence)
+        normalized_names.append(" ".join(unicodedata.normalize("NFKD", person).encode("ascii", "ignore").decode().casefold().split()))
+
+    retained = []
+    for line in whatsapp_message.splitlines():
+        normalized = " ".join(unicodedata.normalize("NFKD", line).encode("ascii", "ignore").decode().casefold().split())
+        is_direct_bullet = (line.lstrip().startswith("•") and any(name and name in normalized for name in normalized_names))
+        if normalized.strip("* ") == "mensagens diretas":
+            continue
+        if not is_direct_bullet:
+            retained.append(line)
+    title = ""
+    for position, line in enumerate(retained):
+        if re.match(r"^\s*\*Painel IFC\b", line):
+            title = line.strip()
+            del retained[position]
+            break
+    rest = "\n".join(retained).strip()
+    direct_section = (title + "\n\n" if title else "") + "\n".join(bullets)
+    budget = max(0, 1950 - len(direct_section))
+    kept = []
+    for line in rest.splitlines():
+        candidate = "\n".join(kept + [line])
+        if len(candidate) <= budget:
+            kept.append(line)
+    rest_text = "\n".join(kept).strip()
+    rest_text = re.sub(r"(?im)^\s*\*?\s*(?:⚠️\s*)?para você\s*\*?\s*$", "*⚠️ Para você*", rest_text)
+    rest_text = re.sub(r"(?im)^\s*\*Mensagens diretas\*\s*$", "", rest_text).strip()
+    direct_text = "\n".join(bullets)
+    marker = "*⚠️ Para você*"
+    if marker in rest_text:
+        before, after = rest_text.split(marker, 1)
+        return (before.rstrip() + ("\n\n" if before.strip() else "") + marker + "\n" + direct_text
+                + (("\n" + after.lstrip()) if after.strip() else ""))
+    return rest_text + (("\n\n" if rest_text else "") + "*⚠️ Para você*\n" + direct_text if direct_text else "")
+
