+def normalize_review_quotes(payload: dict, sources: dict) -> None:
+    """Use the exact source excerpt for model-selected review indexes."""
+    for field, index_name, expected_fn in (
+        ("question_review", "question_index", expected_question_marks),
+        ("request_review", "request_index", expected_request_candidates),
+    ):
+        reviews = payload.get(field)
+        if not isinstance(reviews, list):
+            continue
+        expected = expected_fn(sources)
+        lookup = {(source, row["record_index"], row[index_name]): row["quote"]
+                  for source, rows in expected.items() for row in rows}
+        for review in reviews:
+            if not isinstance(review, dict):
+                continue
+            quote = lookup.get((review.get("source"), review.get("record_index"), review.get(index_name)))
+            if quote is not None:
+                review["quote"] = quote
+        complete_review_list(payload, field, index_name, expected, lookup)
+
+
+REVIEW_AUTOFILL = {"question_review": 0, "request_review": 0}
+DEGRADED = {"evidence_quote_dropped": 0, "evidence_duplicate_merged": 0, "uncited_claims_removed": 0, "review_placeholder_added": 0}
+_DEGRADE_DEPTH = []
+
+
+def complete_review_list(payload: dict, field: str, index_name: str, expected: dict, lookup: dict) -> None:
+    """Deterministically repair the review list: drop unknown/duplicate rows, retarget invalid rows and add
+    a neutral 'informational' review for marks the model skipped (counted and reported, never hidden)."""
+    reviews = payload.get(field)
+    sections = payload.get("sections")
+    if not isinstance(reviews, list) or not isinstance(sections, dict) or not lookup:
+        return
+    allowed = {"actionable_open": {"pedidos", "proximos_passos"}, "answered": {"fatos", "decisoes"},
+               "informational": {"temas", "fatos"}, "rhetorical": {"temas", "fatos"}, "not_a_request": {"temas", "fatos"}}
+    def neutral_target(source):
+        section = sections.get(source) if isinstance(sections.get(source), dict) else {}
+        for name in ("temas", "fatos"):
+            rows = section.get(name)
+            if isinstance(rows, list) and rows and isinstance(rows[0], str) and rows[0].strip():
+                return name
+        return None
+    kept, seen, fixed = [], set(), 0
+    for review in reviews:
+        if not isinstance(review, dict):
+            continue
+        identity = (review.get("source"), review.get("record_index"), review.get(index_name))
+        if identity not in lookup or identity in seen:
+            continue
+        rows = sections.get(identity[0], {}).get(review.get("field"), []) if isinstance(sections.get(identity[0]), dict) else []
+        item_index = review.get("item_index")
+        valid = (review.get("disposition") in allowed and review.get("field") in allowed.get(review.get("disposition"), set())
+                 and (field == "question_review" or review.get("disposition") != "rhetorical")
+                 and (field == "request_review" or review.get("disposition") != "not_a_request")
+                 and isinstance(rows, list) and type(item_index) is int and 0 <= item_index < len(rows)
+                 and isinstance(rows[item_index], str) and rows[item_index].strip())
+        if not valid:
+            target = neutral_target(identity[0])
+            if target is None:
+                kept.append(review); seen.add(identity); continue
+            review = {"source": identity[0], "record_index": identity[1], index_name: identity[2],
+                      "disposition": "informational", "field": target, "item_index": 0, "quote": lookup[identity]}
+            fixed += 1
+        kept.append({key: review[key] for key in ("source", "record_index", index_name, "disposition", "field", "item_index", "quote") if key in review})
+        seen.add(identity)
+    missing = [identity for identity in lookup if identity not in seen]
+    for identity in missing:
+        target = neutral_target(identity[0])
+        if target is None and isinstance(sections.get(identity[0]), dict):
+            # degrade: add one neutral, quote-backed theme so the review can point at it
+            section = sections[identity[0]]
+            section.setdefault("temas", []).append("Houve perguntas e conversas pontuais registradas nesta fonte.")
+            payload.setdefault("evidence", []).append({"source": identity[0], "field": "temas", "item_index": len(section["temas"]) - 1,
+                                                       "record_index": identity[1], "quote": lookup[identity]})
+            DEGRADED["review_placeholder_added"] += 1
+            target = "temas"
+        if target is None:
+            return
+        kept.append({"source": identity[0], "record_index": identity[1], index_name: identity[2],
+                     "disposition": "informational", "field": target, "item_index": 0, "quote": lookup[identity]})
+    payload[field] = kept
+    REVIEW_AUTOFILL[field] = len(missing) + fixed
+
