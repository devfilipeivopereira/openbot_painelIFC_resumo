+def persist_open_direct_items(conversations: list, whatsapp_message: str) -> str:
+    """Keep unresolved direct-message threads for up to 14 days with private permissions."""
+    path = STATE / "curation" / "open-items.json"
+    today = datetime.now(ZoneInfo("America/Sao_Paulo")).date()
+    try:
+        previous = json.loads(path.read_text(encoding="utf-8"))
+        if not isinstance(previous, list): previous = []
+    except (OSError, ValueError, TypeError):
+        previous = []
+    old = {}
+    for item in previous:
+        if not isinstance(item, dict) or not isinstance(item.get("key"), str): continue
+        try: opened = date.fromisoformat(item.get("opened", ""))
+        except ValueError: continue
+        if 0 <= (today - opened).days <= 14: old[item["key"]] = item
+    current = {}
+    seen_people = {}
+    for row in conversations if isinstance(conversations, list) else []:
+        if not isinstance(row, dict) or not isinstance(row.get("person"), str): continue
+        if "filipe ivo pereira" in row["person"].casefold(): continue
+        response = unicodedata.normalize("NFKD", str(row.get("response", ""))).encode("ascii", "ignore").decode().casefold()
+        seen_people[row["person"].casefold()] = bool(response.strip()) and not re.search(r"sem resposta|nao respondeu|nenhuma resposta|sem retorno|nao houve resposta", response)
+        if not re.search(r"sem resposta|nao respondeu|nenhuma resposta|sem retorno|nao houve resposta", response): continue
+        request = " ".join(str(row.get("request", "")).split())[:240]
+        for pattern in PII_PATTERNS: request = pattern.sub("[removido]", request)
+        key = unicodedata.normalize("NFKD", row["person"] + "|" + request).encode("ascii", "ignore").decode().casefold()
+        opened = old.get(key, {}).get("opened", today.isoformat())
+        person_name = row["person"]
+        for pattern in PII_PATTERNS: person_name = pattern.sub("[removido]", person_name)
+        current[key] = {"key": key, "person": person_name, "request": request, "opened": opened}
+    for key, item in old.items():
+        person_key = str(item.get("person", "")).casefold()
+        if key not in current and person_key not in seen_people:
+            current[key] = item
+    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+    fd, temporary = tempfile.mkstemp(prefix=".open-items-", dir=path.parent)
+    try:
+        os.fchmod(fd, 0o600)
+        with os.fdopen(fd, "w", encoding="utf-8") as output:
+            json.dump(list(current.values()), output, ensure_ascii=False, separators=(",", ":"))
+            output.flush(); os.fsync(output.fileno())
+        os.replace(temporary, path)
+        os.chmod(path, 0o600)
+    finally:
+        if os.path.exists(temporary): os.unlink(temporary)
+    result = whatsapp_message
+    carry = []
+    for item in current.values():
+        if item["opened"] == today.isoformat(): continue
+        person = " ".join(unicodedata.normalize("NFKD", item["person"]).encode("ascii", "ignore").decode().casefold().split())
+        lines = result.splitlines()
+        for index, line in enumerate(lines):
+            normalized = " ".join(unicodedata.normalize("NFKD", line).encode("ascii", "ignore").decode().casefold().split())
+            if line.lstrip().startswith("•") and person in normalized and "(desde " not in normalized:
+                lines[index] = line.rstrip().rstrip(".") + f" (desde {date.fromisoformat(item['opened']):%d/%m})."
+                break
+        else:
+            carry.append(f"• {item['person']}: {item['request']} (desde {date.fromisoformat(item['opened']):%d/%m}).")
+        result = "\n".join(lines)
+    if carry:
+        marker = "*⚠️ Para você*"
+        if marker in result:
+            before, after = result.split(marker, 1)
+            result = before + marker + "\n" + "\n".join(carry) + ("\n" + after.lstrip() if after.strip() else "")
+        else:
+            result += "\n\n" + marker + "\n" + "\n".join(carry)
+    return result
+
+
+def nested_strings(value):
+    if isinstance(value, str):
+        yield value
+    elif isinstance(value, dict):
+        for child in value.values():
+            yield from nested_strings(child)
+    elif isinstance(value, list):
+        for child in value:
+            yield from nested_strings(child)
+
+
+def prepare_digest_records(sources: dict, start_hour: int | None = None) -> dict:
+    """Build chronological, deduplicated WhatsApp-facing records without changing evidence indexes."""
+    result = {}
+    zone = ZoneInfo("America/Sao_Paulo")
+    now = datetime.now(zone)
+    edition = os.environ.get("IFC_DIGEST_EDITION", "matinal")
+    lower_hour = start_hour if start_hour is not None else {"matinal": 0, "tarde": 7, "noturno": 14}.get(edition, 0)
+    lower_bound = now.replace(hour=lower_hour, minute=0, second=0, microsecond=0)
+    noise = re.compile(r"^(?:bom dia|boa tarde|boa noite|bom descanso|am[eé]m|ok|[🙏🙌👏❤️💛😂🤣👍🏻👍🏽👍🏿\s.!]+)$", re.I)
+    for source, bundle in sources.items():
+        rows = bundle.get("records", []) if isinstance(bundle, dict) else []
+        kept, seen = [], set()
+        for row in rows:
+            if not isinstance(row, dict): continue
+            if row.get("forwarded_many_times") is True or (type(row.get("forwarded_count")) is int and row["forwarded_count"] >= 5): continue
+            stamp = row.get("at", row.get("timestamp", row.get("received_at")))
+            if isinstance(stamp, str):
+                try:
+                    parsed = datetime.fromisoformat(stamp.replace("Z", "+00:00"))
+                    parsed = parsed.astimezone(zone) if parsed.tzinfo else parsed.replace(tzinfo=zone)
+                    if parsed.date() != now.date() or not lower_bound <= parsed <= now: continue
+                except ValueError:
+                    pass
+            text = str(row.get("text", "")).strip()
+            kind = str(row.get("type", "")).casefold()
+            if kind in {"stickermessage", "reactionmessage", "reaction"} or not text: continue
+            if noise.fullmatch(text): continue
+            normalized = " ".join(unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode().casefold().split())
+            if "encaminhada muitas vezes" in normalized or "forwarded many times" in normalized: continue
+            identity = (str(row.get("group", row.get("person", row.get("sender", "")))).casefold(), normalized)
+            if identity in seen: continue
+            seen.add(identity)
+            kept.append(row)
+        kept.sort(key=lambda row: str(row.get("at", row.get("timestamp", row.get("received_at", "")))))
+        result[source] = kept
+    return result
+
+
+def normalized_quote_map(value: str) -> tuple[str, list[int]]:
+    chars, positions = [], []
+    punctuation = {"’": "'", "‘": "'", "“": '"', "”": '"', "–": "-", "—": "-"}
+    for index, character in enumerate(value):
+        normalized = unicodedata.normalize("NFKD", unicodedata.normalize("NFKC", punctuation.get(character, character)).casefold())
+        for char in normalized:
+            if unicodedata.combining(char):
+                continue
+            if char.isspace():
+                if chars and chars[-1] != " ":
+                    chars.append(" "); positions.append(index)
+            else:
+                chars.append(char); positions.append(index)
+    while chars and chars[-1] == " ":
+        chars.pop(); positions.pop()
+    while chars and chars[0] == " ":
+        chars.pop(0); positions.pop(0)
+    return "".join(chars), positions
+
+
+def source_excerpt(text: str, start: int, end: int) -> str:
+    """Return a bounded literal source excerpt around a question or request cue."""
+    left_boundaries = [text.rfind(mark, 0, start) for mark in ("\n", ".", "!", "?")]
+    left = max(left_boundaries) + 1
+    right_candidates = [position for mark in ("\n", ".", "!", "?")
+                        if (position := text.find(mark, end)) >= 0]
+    right = min(right_candidates) + 1 if right_candidates else len(text)
+    if right - left > 300:
+        center = (start + end) // 2
+        left = max(left, center - 149)
+        right = min(right, left + 300)
+        if right - end < 20:
+            left = max(left_boundaries) + 1
+            right = min(len(text), left + 300)
+    excerpt = text[left:right].strip()
+    if len(excerpt) > 300:
+        excerpt = excerpt[:300].rstrip()
+    if len(excerpt) < 6:
+        left = max(0, start - 140)
+        right = min(len(text), max(end + 140, left + 6))
+        excerpt = text[left:right].strip()[:300]
+    return excerpt
+
+
+def locate_evidence_quote(records: list, quote: str):
+    normalized_quote, _ = normalized_quote_map(quote)
+    if not normalized_quote:
+        return None
+    for index, record in enumerate(records):
+        if not isinstance(record, dict):
+            continue
+        for value in nested_strings(record):
+            if quote in value:
+                return index, quote
+            normalized_value, positions = normalized_quote_map(value)
+            start = normalized_value.find(normalized_quote)
+            if start >= 0 and start + len(normalized_quote) <= len(positions):
+                actual = value[positions[start]:positions[start + len(normalized_quote) - 1] + 1]
+                if 6 <= len(actual) <= 300:
+                    return index, actual
+    return None
+
+
+class PipelineError(RuntimeError):
+    pass
