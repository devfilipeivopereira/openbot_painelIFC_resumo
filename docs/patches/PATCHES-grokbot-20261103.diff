+CODEX_LIMIT_PATTERN = re.compile(r"usage limit|rate.?limit|hit your limit|insufficient_quota|quota|\b429\b", re.I)
+
+
+def run_codex(args: list[str], *, input: bytes | None = None, timeout: int = 900) -> subprocess.CompletedProcess:
+    """Run Codex; on a ChatGPT usage limit switch to the next codex-auth account and retry once per account."""
+    result = run(args, input=input, timeout=timeout)
+    for _ in range(2):
+        if not result.returncode:
+            return result
+        output = (result.stderr or b"").decode("utf-8", "replace") + (result.stdout or b"").decode("utf-8", "replace")
+        if not CODEX_LIMIT_PATTERN.search(output):
+            return result
+        switch = run(["docker", "exec", "-u", "1000", "openbot", "/bin/bash", "-c",
+                      "export PATH=/data/.local/bin:$PATH; n=$(codex-auth list --skip-api --json | jq -r "
+                      "'.accounts as $a | ([$a[].active]|index(true)) as $i | $a[(($i+1) % ($a|length))].number'); "
+                      "[ -n \"$n\" ] && codex-auth switch \"$n\" >/dev/null"], timeout=60)
+        if switch.returncode:
+            return result
+        result = run(args, input=input, timeout=timeout)
+    return result
+
