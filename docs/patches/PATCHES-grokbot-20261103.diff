+    for task in tasks:
+        if not isinstance(task, dict) or todoist_onboarding(task) or not isinstance(task.get("content"), str): continue
+        state = str(task.get("status", "prazo_nao_interpretado")); due = None
+        try: due = date.fromisoformat(str(task.get("due_date", ""))[:10])
+        except ValueError: pass
+        include = state in {"atrasada", "hoje"} or (state == "futura" and due and today < due <= today + timedelta(days=7)) or (state in {"sem_prazo", "prazo_nao_interpretado"} and task.get("priority", 0) >= 4)
+        if state == "sem_prazo":
+            if task not in no_due[:3]:
+                continue
+            undated_remaining = no_due[3:]
+        if include and task["content"].casefold() not in existing: missing.append(f"• {task['content']} — prazo a conferir")
+    if undated_remaining:
+        missing.append(f"• +{len(undated_remaining)} sem prazo")
+    if not missing: return whatsapp_message
+    return whatsapp_message.rstrip() + "\n\n*Pendências prioritárias*\n" + "\n".join(missing)
+
+def todoist_onboarding(task: dict) -> bool:
+    normalize = lambda value: unicodedata.normalize("NFKD", str(value or "")).encode("ascii", "ignore").decode().casefold()
+    title = normalize(task.get("content"))
+    project = normalize(task.get("project") or task.get("project_name"))
+    ignored = ("adicionar secoes", "instalar todoist", "explore", "experimente", "baixe", "conecte", "getting started", "bem-vindo", "bem vindo", "dica")
+    return any(word in title or word in project for word in ignored)
