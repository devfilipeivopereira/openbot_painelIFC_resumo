FROM python:3.12-alpine
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 IFC_MCP_TOKEN_FILE=/run/secrets/ifc-mcp-token
WORKDIR /app
COPY requirements-mcp.txt mcp_gateway.py job_runner.py dashboard_publisher.py ./
COPY collectors/ /app/collectors/
RUN apk add --no-cache tesseract-ocr tesseract-ocr-data-por tesseract-ocr-data-eng poppler-utils ffmpeg nodejs \
 && pip install --no-cache-dir -r requirements-mcp.txt \
 && chmod 0555 /app \
 && chmod 0444 /app/*.py /app/*.txt /app/collectors/*.py
USER 65534:65534
EXPOSE 8765
ENTRYPOINT ["python3", "/app/mcp_gateway.py"]
